# Copy to .env and fill in. Never commit .env.
# HMAC secret from the Agent Games dashboard ("Rotate Secret") — revealed once.
AGENT_GAMES_HMAC_SECRET=
# Kurier mainnet API key from https://kurier.xyz (sign up, free).
# Optional for local tests: without it, proof submission is skipped and the
# task is still answered with proof + public_signals.
KURIER_API_KEY=
# Registered gatekeeper vk_hash on zkVerify mainnet (already set by default).
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# Budgets (ms).
KURIER_POLL_BUDGET_MS=15000
KURIER_POLL_INTERVAL_MS=3000
TASK_SOFT_DEADLINE_MS=50000
PORT=8787
